# ============================================================
# Variables de entorno NEM Plataforma (Módulo Docente)
# SPEC_TEC_05 §4.2 — 28 variables totales (17 server-only, 11 public)
# ============================================================
# IMPORTANTE: Este archivo es solo PLANTILLA. Los valores reales van en
# .env.local (gitignored) o en Vercel Dashboard → Settings → Environment Variables.
# NUNCA commitear .env.local ni secrets.

# ============================================================
# 1. SUPABASE (8) — server+public o server-only
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...                 # server-only, NUNCA en bundle
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=xxxxxxxxxxxxx
SUPABASE_STORAGE_URL=https://xxxxx.supabase.co/storage/v1
SUPABASE_DB_POOL_SIZE=10                         # solo prod
SUPABASE_DB_SSL=require                          # solo prod

# ============================================================
# 2. IA / MiniMax (5) — server-only
# D-FIN-13: IA para F1 (variantes bloque), F2 (redacción), F3 (pulir PDF),
# F-IA1 (sugerir uso recurso).
# ============================================================
AI_PROVIDER=minimax
AI_API_KEY=                                      # NUNCA en bundle
AI_BASE_URL=https://api.minimax.chat/v1
AI_MODEL=minimax-m3
AI_TIMEOUT_MS=8000                               # solo prod

# ============================================================
# 3. Next.js (5)
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000         # dev | staging | prod URL
NEXT_PUBLIC_APP_ENV=development                  # development | staging | production
NODE_ENV=development
NEXT_PUBLIC_CATALOGO_VERSION=PLAN_2022_ED_2025_FASE_2
NEXT_PUBLIC_ENABLE_COMPARACION_MESES=false       # feature flag M3 T6
PDF_GENERATOR=playwright                         # solo prod

# ============================================================
# 4. PDF y URLs firmadas (3) — server-only
# D-FIN-5: URLs firmadas con JWT para entrega al director.
# ============================================================
PDF_URL_FIRMA_EXPIRA_DIAS=30                     # solo prod
JWT_SECRET=                                      # openssl rand -base64 32, NUNCA commit
PDF_STORAGE_BUCKET=planeaciones                  # solo prod

# ============================================================
# 5. WhatsApp / Director (2) — server-only
# D-FIN-19: wa.me deep link en MVP, sin API.
# ============================================================
WHATSAPP_BUSINESS_API_TOKEN=                     # opcional MVP (vacío si solo wa.me)
WHATSAPP_OTP_TEMPLATE_NAME=nem_otp_es

# ============================================================
# 6. Monitoreo / Sentry (2)
# ============================================================
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                               # solo prod, para source maps

# ============================================================
# 7. CI/CD (3) — GitHub Actions secrets
# ============================================================
# VERCEL_TOKEN=
# SUPABASE_ACCESS_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
